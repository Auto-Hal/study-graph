# Notion integration secret. Do not commit the real value.
NOTION_TOKEN=

# Required for review persistence. Keep server-side; do not prefix with NEXT_PUBLIC_.
# Store only the SHA-256 hash in Supabase private.study_graph_config.
STUDY_GRAPH_APP_TOKEN=

# Single-user web login password. Keep server-side; do not prefix with NEXT_PUBLIC_.
# Use a long random value. This is separate from STUDY_GRAPH_APP_TOKEN.
STUDY_GRAPH_ACCESS_PASSWORD=

# Optional overrides. Study Graph already has safe built-in defaults for this dedicated Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Phase 4C/4D pilot runtime. Keep the service role key server-only.
SUPABASE_SERVICE_ROLE_KEY=
# Fixed single-user learner identity; the browser never supplies this value.
STUDY_GRAPH_LEARNER_ID=
# Optional provenance label used when registering the pilot archive.
STUDY_GRAPH_SOURCE_GIT_SHA=
# Operational containment switch for the versioned/Objective pilot. Defaults to enabled when unset.
# Set to false to stop issuing new pilot instances while preserving attempts/retries for already-issued instances.
STUDY_GRAPH_PILOT_ISSUANCE_ENABLED=
# Exact "true" selects generic Objective v2 for NEW online Kuzushiji issuance
# underneath the pilot kill switch. Unset/any other value keeps new issuance on
# v1. This flag never selects the acceptance writer: existing v2 instances
# remain on the context-aware v2 acceptance path if the flag is later turned off.
STUDY_GRAPH_OBJECTIVE_V2_ISSUANCE_ENABLED=
# Optional client-side emergency switch for the minimal offline app shell.
# Defaults to enabled; false stops new service-worker registration and keeps all durable data.
NEXT_PUBLIC_STUDY_GRAPH_OFFLINE_SHELL_ENABLED=
