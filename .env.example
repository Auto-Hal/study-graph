# Notion integration secret. Do not commit the real value.
NOTION_TOKEN=

# Study Graph Supabase project. Keep these server-side; do not prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Random private token used by Vercel server routes to call the protected Study Graph RPCs.
# Store only the SHA-256 hash in Supabase private.study_graph_config.
STUDY_GRAPH_APP_TOKEN=
