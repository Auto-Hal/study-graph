# Notion integration secret. Do not commit the real value.
NOTION_TOKEN=

# Required for review persistence. Keep server-side; do not prefix with NEXT_PUBLIC_.
# Store only the SHA-256 hash in Supabase private.study_graph_config.
STUDY_GRAPH_APP_TOKEN=

# Optional overrides. Study Graph already has safe built-in defaults for this dedicated Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
